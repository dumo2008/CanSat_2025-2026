    {
        "id": "31b7767142ce4454",
        "type": "json",
        "z": "25b10c77aebb2361",
        "g": "02a9d1ac47716a8b",
        "name": "parse JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 250,
        "y": 180,
        "wires": [
            [
                "2b53d36f0b1b078c"
            ]
        ]
    },
    {
        "id": "2b53d36f0b1b078c",
        "type": "function",
        "z": "25b10c77aebb2361",
        "g": "02a9d1ac47716a8b",
        "name": "store flow vars by type",
        "func": "// Accepts JSON records like:\n// {\"type\":\"B\",\"temperature\":20.7,\"pressure\":1029,\"altitude\":-109.3}\n// {\"type\":\"G\",\"sats\":0,\"hdop\":0.0,\"lat\":\"0.0\",\"long\":\"0.0\",\"timestamp\":\"...\",\"alt_gps\":\"0.00\"}\n// {\"type\":\"M\",\"motor1\":0,\"motor2\":1}\n\nlet p = msg.payload;\n\n// If mqtt-in already gave an object, keep it. If it's a string, parse it.\nif (typeof p === \"string\") {\n    try { p = JSON.parse(p); }\n    catch (e) { node.warn(\"Invalid JSON: \" + msg.payload); return null; }\n}\n\nif (!p || !p.type) return null;\n\nswitch (p.type) {\n    case \"B\":\n        flow.set(\"temp\", p.temperature);\n        flow.set(\"pressure\", p.pressure);\n        flow.set(\"alt-bmp\", p.altitude);\n        break;\n\n    case \"G\":\n        flow.set(\"sats\", p.sats);\n        flow.set(\"hdop\", p.hdop);\n        flow.set(\"lat\", p.lat);\n        flow.set(\"lon\", p.long);\n        flow.set(\"alt_gps\", p.alt_gps);\n        flow.set(\"gps_timestamp\", p.timestamp);\n        break;\n\n    case \"M\":\n        flow.set(\"turnL\", p.turnL);\n        flow.set(\"turnR\", p.turnR);\n        flow.set(\"status\", p.status);\n        break;\n\n    default:\n        // ignore unknown types\n        return null;\n}\n\n// pass through to the existing link-out fanout\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 180,
        "wires": [
            [
                "93b5657edabad32f"
            ]
        ]
    },
