    {
        "id": "a8f06bdfff7e3b1d",
        "type": "function",
        "z": "25b10c77aebb2361",
        "g": "792cdf27f8029567",
        "name": "function 14",
        "func": "let lat = parseFloat(flow.get(\"lat\"));\nlet lon = parseFloat(flow.get(\"lon\"));\n\nif (!isFinite(lat) || !isFinite(lon)) return null;\n\nmsg.payload = {\n    name: \"CanSat\",\n    lat: lat,\n    lon: lon,\n    label: `Lat: ${lat}, Lon: ${lon}`,\n    icon: \"fa-rocket\",\n    layer: \"CanSat\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
